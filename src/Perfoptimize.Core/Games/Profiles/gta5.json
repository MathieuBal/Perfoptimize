{
  "name": "Grand Theft Auto V",
  "executables": ["GTA5.exe", "GTA5_Enhanced.exe"],
  "upscalers": ["dlss", "fsr"],
  "configFiles": [
    { "path": "%DOCUMENTS%\\Rockstar Games\\GTA V\\settings.xml", "format": "xml" }
  ],
  "settings": [
    { "name": "MSAA", "impact": "gpu", "qualityLoss": 2, "performanceGain": 5, "estimatedGainPercent": 25 },
    { "name": "Grass Quality", "impact": "gpu", "qualityLoss": 2, "performanceGain": 4, "estimatedGainPercent": 12 },
    { "name": "Post FX", "impact": "gpu", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 8 },
    { "name": "Shadow Quality", "impact": "gpu", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 8 },
    {
      "name": "Texture Quality", "impact": "vram", "qualityLoss": 2, "performanceGain": 1, "estimatedGainPercent": 2,
      "vramGiBByLevel": { "Normal": 2, "High": 4, "Very High": 6 }
    },
    { "name": "Population Density", "impact": "cpu", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 8 },
    { "name": "Distance Scaling", "impact": "mixed", "qualityLoss": 3, "performanceGain": 3, "estimatedGainPercent": 8 }
  ]
}
