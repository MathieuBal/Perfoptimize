{
  "name": "Cyberpunk 2077",
  "executables": ["Cyberpunk2077.exe"],
  "upscalers": ["dlss", "dlss-fg", "fsr", "fsr-fg", "xess"],
  "configFiles": [
    { "path": "%LOCALAPPDATA%\\CD Projekt Red\\Cyberpunk 2077\\UserSettings.json", "format": "json" }
