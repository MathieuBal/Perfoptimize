    { "name": "Volumetric Fog", "impact": "gpu", "qualityLoss": 1, "performanceGain": 3, "estimatedGainPercent": 8 },
    { "name": "Shadows", "impact": "gpu", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 8 },
    {
      "name": "Texture Quality", "impact": "vram", "qualityLoss": 2, "performanceGain": 1, "estimatedGainPercent": 2,
      "vramGiBByLevel": { "Low": 4, "Medium": 5, "High": 7 }
    },
    { "name": "Crowd Density", "impact": "cpu", "qualityLoss": 2, "performanceGain": 4, "estimatedGainPercent": 10 },
    { "name": "Distant Object Detail (LOD)", "impact": "mixed", "qualityLoss": 3, "performanceGain": 3, "estimatedGainPercent": 8 }
