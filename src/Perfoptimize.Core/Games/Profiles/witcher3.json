{
  "name": "The Witcher 3: Wild Hunt",
  "executables": ["witcher3.exe"],
  "upscalers": ["dlss", "dlss-fg", "fsr"],
  "configFiles": [
    { "path": "%DOCUMENTS%\\The Witcher 3\\user.settings", "format": "ini" }
  ],
  "advisories": [
    {
      "id": "witcher3-hairworks",
      "setting": "NVIDIA HairWorks",
      "kind": "poorValue",
      "conditions": [
        { "key": "HairWorksLevel", "operator": "isOn", "value": "1" }
      ],
      "recommendation": { "action": "disable", "targetValue": "0" },
      "recommendationText": "Désactiver, ou limiter à Geralt uniquement",
      "detail": "HairWorks coûte très cher en performances pour un gain visuel faible, surtout sur cartes AMD.",
      "evidence": {
        "level": "curatedCommunityClaim",
        "sources": [{ "url": "https://www.pcgamingwiki.com/wiki/The_Witcher_3:_Wild_Hunt", "note": "Coût perf HairWorks documenté" }],
        "lastVerified": "2026-07-14",
        "gameVersions": []
      },
      "automaticApplication": true
    },
    {
      "id": "witcher3-nextgen-rt",
      "setting": "Ray Tracing (mise à jour next-gen)",
      "kind": "stutter",
      "conditions": [
        { "key": "RayTracing", "operator": "isOn", "value": "1" }
      ],
      "priorityWhen": [
        { "system": "bottleneck", "operator": "equals", "value": "Gpu" }
      ],
      "recommendation": { "action": "disable", "targetValue": "0" },
      "recommendationText": "Désactiver si tu as des saccades",
      "detail": "Le ray tracing de la mise à jour next-gen provoque des saccades de traversée sur de nombreuses configurations.",
      "evidence": {
        "level": "curatedCommunityClaim",
        "sources": [],
        "lastVerified": "2026-07-14",
        "gameVersions": ["4.0", "next-gen"]
      },
      "automaticApplication": false
    }
  ],
  "settings": [
    { "name": "Ray Tracing", "impact": "gpu", "qualityLoss": 2, "performanceGain": 5, "estimatedGainPercent": 30 },
    {
      "name": "NVIDIA HairWorks", "impact": "gpu", "qualityLoss": 1, "performanceGain": 4, "estimatedGainPercent": 12,
      "config": { "file": "user.settings", "section": "Rendering", "key": "HairWorksLevel", "levels": ["0", "1", "2"] }
    },
    {
      "name": "Shadow Quality", "impact": "gpu", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 8,
      "config": { "file": "user.settings", "section": "Rendering", "key": "ShadowQuality", "levels": ["0", "1", "2", "3", "4"] }
    },
    { "name": "Foliage Visibility Range", "impact": "mixed", "qualityLoss": 2, "performanceGain": 3, "estimatedGainPercent": 10 },
    {
      "name": "Texture Quality", "impact": "vram", "qualityLoss": 2, "performanceGain": 1, "estimatedGainPercent": 2,
      "vramGiBByLevel": { "Low": 1.5, "Medium": 2.5, "High": 3.5 }
    },
    { "name": "Number of Background Characters", "impact": "cpu", "qualityLoss": 1, "performanceGain": 2, "estimatedGainPercent": 5 }
  ]
}
