<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Perfoptimize.Core\Perfoptimize.Core.csproj" />
    <!-- Installer + auto-update (Velopack). Keep in lock-step with the vpk CLI
         version used by .github/workflows/release.yml. -->
    <PackageReference Include="Velopack" Version="1.1.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Perfoptimize</AssemblyName>
    <RootNamespace>Perfoptimize.App</RootNamespace>
    <!-- Single-file friendly: the UI assets are embedded, not loose files. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serve the dashboard from embedded resources so a single-file .exe works. -->
    <EmbeddedResource Include="WebAssets\**\*" />
  </ItemGroup>

</Project>
